ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
SITE_GATEWAY_DATA=/DATA/AppData/site-gateway
PUID=1000
PGID=1000
ACME_EMAIL=you@example.com
HTTP_PORT=80
HTTPS_PORT=443
BACKUP_PASSWORD=

