<?xml version="1.0"?>
<Container version="2">
  <Name>Web Server</Name>
  <Repository>ghcr.io/mfwadejr/web-server:latest</Repository>
  <Registry>https://github.com/mfwadejr/web-server/pkgs/container/web-server</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/mfwadejr/web-server/issues</Support>
  <Project>https://github.com/mfwadejr/web-server</Project>
  <Overview>A simple dashboard for uploading, enabling, disabling, and serving static websites on assigned ports.</Overview>
  <Category>Network:Web</Category>
  <WebUI>http://[IP]:[PORT:8080]</WebUI>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires>Publish the desired site-port range when installing. The default template publishes 9000-9099.</Requires>
  <Config Name="Dashboard" Target="8080" Default="8080" Mode="tcp" Description="Administration dashboard" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Site ports" Target="9000-9099" Default="9000-9099" Mode="tcp" Description="Ports available for hosted sites" Type="Port" Display="always" Required="true" Mask="false">9000-9099</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/web-server" Mode="rw" Description="Persistent sites and configuration" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/web-server</Config>
  <Config Name="Admin username" Target="ADMIN_USERNAME" Default="admin" Mode="" Description="Dashboard login name" Type="Variable" Display="always" Required="true" Mask="false">admin</Config>
  <Config Name="Admin password" Target="ADMIN_PASSWORD" Default="" Mode="" Description="Use a long, unique password" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Session secret" Target="SESSION_SECRET" Default="" Mode="" Description="At least 32 random characters" Type="Variable" Display="advanced" Required="true" Mask="true"/>
  <Config Name="Minimum site port" Target="SITE_PORT_MIN" Default="9000" Mode="" Description="Lowest available site port" Type="Variable" Display="advanced" Required="true" Mask="false">9000</Config>
  <Config Name="Maximum site port" Target="SITE_PORT_MAX" Default="9099" Mode="" Description="Highest available site port" Type="Variable" Display="advanced" Required="true" Mask="false">9099</Config>
</Container>
